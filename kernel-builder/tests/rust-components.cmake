# Configure Rust targets without CUDA or compiling crates.
# Run: cmake -P kernel-builder/tests/rust-components.cmake
cmake_minimum_required(VERSION 3.24)
if(CMAKE_SCRIPT_MODE_FILE)
    set(_TEST_DIR "${CMAKE_CURRENT_BINARY_DIR}/rust-components-test")
    file(MAKE_DIRECTORY "${_TEST_DIR}")
    file(WRITE "${_TEST_DIR}/CMakeLists.txt"
        "cmake_minimum_required(VERSION 3.24)\nproject(rust_components NONE)\ninclude(\"${CMAKE_CURRENT_LIST_FILE}\")\n")
    file(WRITE "${_TEST_DIR}/crate/Cargo.toml"
        "[package]\nname = \"example\"\nversion = \"0.0.0\"\nedition = \"2021\"\n[lib]\npath = \"lib.rs\"\n[workspace]\n")
    file(TOUCH "${_TEST_DIR}/crate/lib.rs")
    foreach(_CASE cpu cuda unsupported-arch missing-backend two-components)
        execute_process(COMMAND "${CMAKE_COMMAND}" -S "${_TEST_DIR}"
            -G Ninja -B "${_TEST_DIR}/${_CASE}" "-DCASE=${_CASE}"
            RESULT_VARIABLE _RESULT OUTPUT_VARIABLE _OUTPUT ERROR_VARIABLE _ERROR)
        if(_CASE STREQUAL "unsupported-arch")
            if(_RESULT EQUAL 0 OR NOT _ERROR MATCHES "empty set of capabilities")
                message(FATAL_ERROR "Expected unsupported architecture error: ${_OUTPUT}${_ERROR}")
            endif()
        elseif(_CASE STREQUAL "missing-backend")
            if(_RESULT EQUAL 0 OR NOT _ERROR MATCHES "require CUDA_OXIDE_BACKEND")
                message(FATAL_ERROR "Expected missing backend error: ${_OUTPUT}${_ERROR}")
            endif()
        elseif(_CASE STREQUAL "two-components")
            if(_RESULT EQUAL 0 OR NOT _ERROR MATCHES "only one is supported")
                message(FATAL_ERROR "Expected two components error: ${_OUTPUT}${_ERROR}")
            endif()
        elseif(NOT _RESULT EQUAL 0)
            message(FATAL_ERROR "${_CASE} configuration failed: ${_OUTPUT}${_ERROR}")
        endif()
    endforeach()
    file(REMOVE_RECURSE "${_TEST_DIR}")
    message(STATUS "Rust component configuration tests passed")
    return()
endif()

include("${CMAKE_CURRENT_LIST_DIR}/../src/pyproject/templates/utils.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/../src/pyproject/templates/kernel.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/../src/pyproject/templates/rust.cmake")
set(CARGO_EXECUTABLE cargo)
set(Python_EXECUTABLE python)
set(GPU_LANG CUDA)
set(CUDA_ARCHS "8.0;8.9;9.0")
set(CUDA_KERNEL_ARCHS "8.0;8.9;9.0+PTX")
set(CUDA_OXIDE_BACKEND /test/backend.so)
set(CUDA_PTXAS_EXECUTABLE /test/ptxas)
set(CUDA_FATBINARY_EXECUTABLE /test/fatbinary)
set(CMAKE_OBJCOPY /test/objcopy)
set(_ARGS CUDA_CAPABILITIES 8.0)
if(CASE STREQUAL "cpu")
    set(GPU_LANG CPU)
    set(_ARGS)
elseif(CASE STREQUAL "unsupported-arch")
    set(_ARGS CUDA_CAPABILITIES 6.0)
elseif(CASE STREQUAL "missing-backend")
    unset(CUDA_OXIDE_BACKEND)
endif()
rust_kernel_component(LIBS TARGETS NAME example MANIFEST_PATH crate/Cargo.toml ${_ARGS})
if(NOT TARGET example_rust OR NOT TARGET example_cargo_build)
    message(FATAL_ERROR "Missing shared Cargo/static-library targets")
endif()
if(CASE STREQUAL "cuda")
    if(NOT ALL_GPU_ARCHS STREQUAL "8.0")
        message(FATAL_ERROR "Incorrect capabilities: ${ALL_GPU_ARCHS}")
    endif()
    get_property(_SOURCE GLOBAL PROPERTY RUST_CUDA_FATBIN_SOURCE)
    if(NOT _SOURCE MATCHES "example_fatbin.cpp$")
        message(FATAL_ERROR "Missing fatbin source: ${_SOURCE}")
    endif()
    file(READ ${_SOURCE} _CONTENTS)
    if(NOT _CONTENTS MATCHES "\\.incbin [^\n]*/example\\.fatbin")
        message(FATAL_ERROR "Fatbin source does not include the fatbin:\n${_CONTENTS}")
    endif()
elseif(CASE STREQUAL "two-components")
    rust_kernel_component(LIBS TARGETS NAME other MANIFEST_PATH crate/Cargo.toml ${_ARGS})
endif()
